cabal-version:      3.0
name:               intelhex
version:            0.1.0.0
synopsis:           Intel HEX
description:        Intel HEX reader
homepage:           https://github.com/dopamane/intelhex
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Codec
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

library
  default-language: Haskell2010
  hs-source-dirs:   lib
  ghc-options:      -Wall -Wunused-packages -O2
  exposed-modules:  Codec.IntelHEX
  build-depends:
    base < 5,
    bytestring

executable ihex
  default-language: Haskell2010
  hs-source-dirs:   exe
  ghc-options:      -Wall -Wunused-packages -O2
  main-is:          Main.hs
  other-modules:    Paths_intelhex
  autogen-modules:  Paths_intelhex
  build-depends:
    base < 5,
    bytestring,
    intelhex,
    optparse-applicative

test-suite test
  default-language: Haskell2010
  hs-source-dirs:   test
  ghc-options:      -Wall -Wunused-packages -O2 -threaded
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  build-depends:
    base < 5,
    intelhex,
    tasty,
    tasty-hunit
